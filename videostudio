#!/usr/bin/env bash
# Video Studio AI — Community Edition: lanzador para macOS (y Linux, no validado).
#
#   ./videostudio install   Instalador guiado (requisitos, dependencias, motor, modelo, acceso)
#   ./videostudio start     Inicia el panel (o reutiliza el que ya está en marcha) y lo abre
#   ./videostudio stop      Cierra el panel sin dejar procesos en segundo plano
#   ./videostudio restart   Reinicia
#   ./videostudio status    Muestra si está en marcha y en qué dirección
#   ./videostudio open      Abre el panel en el navegador
#   ./videostudio logs [-f] Muestra el registro del servidor
#   ./videostudio doctor    Diagnóstico del equipo y de la instalación
#   ./videostudio dev       Modo desarrollo (Vite con recarga + API con recarga)
#   ./videostudio check     Validaciones del proyecto (lint, tipos, pruebas, build)
#
# Opciones del instalador: --yes (acepta lo recomendado), --no-model, --model <id>,
# --no-browser-engine, --no-shortcut, --no-start. Nada se instala de forma global.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="$ROOT/backend"
FRONTEND="$ROOT/frontend"
RENDERER="$ROOT/renderer"
PY="$BACKEND/.venv/bin/python"

if [[ -n "${VSA_HOME:-}" ]]; then
  DATA_HOME="$VSA_HOME"
elif [[ "$(uname)" == "Darwin" ]]; then
  DATA_HOME="$HOME/Library/Application Support/VideoStudioAI-Community"
else
  DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/videostudioai-community"
fi
TOOLS="$DATA_HOME/tools"

# Versión fijada de uv (gestor de Python) si hay que descargarlo: huellas de su publicación.
UV_VERSION="0.12.18"
uv_asset() {
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) echo "uv-aarch64-apple-darwin.tar.gz cf40e0c6a202190ccd9e0406dcfdd5b2d6668a9a5c779b17948963df32aafe5b" ;;
    Darwin-x86_64) echo "uv-x86_64-apple-darwin.tar.gz 2e4108f5395397c8bc5d43bf83d3bdbb2d0e92b90d0efa607756be704905fa33" ;;
    *) echo "" ;;
  esac
}

# Desde Finder (.command o acceso directo) el PATH es mínimo: se añaden las rutas habituales.
# VSA_IGNORE_SYSTEM_TOOLS=1 simula un equipo limpio (pruebas de instalación nueva).
if [[ "${VSA_IGNORE_SYSTEM_TOOLS:-}" == "1" ]]; then
  export PATH="$TOOLS/uv:$PATH"
else
  export PATH="$TOOLS/uv:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"
fi
# Python gestionado por uv dentro de la carpeta de datos (no se toca el Python del sistema).
export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-$TOOLS/python}"
export PYTHONUTF8=1

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '  \033[36m›\033[0m %s\n' "$*"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
fail() { printf '  \033[31m✗\033[0m %s\n' "$*" >&2; exit 1; }

has_flag() { local f="$1"; shift; for a in "$@"; do [[ "$a" == "$f" || "$a" == "-y" && "$f" == "--yes" ]] && return 0; done; return 1; }

confirm() {
  # confirm "pregunta" [args del instalador]: --yes o sin terminal → sí.
  local q="$1"; shift
  if has_flag --yes "$@" || [[ ! -t 0 ]]; then info "$q → sí"; return 0; fi
  read -r -p "  ? $q [S/n] " a
  [[ -z "$a" || "$a" =~ ^[sSyY] ]]
}

find_uv() {
  if command -v uv >/dev/null 2>&1; then command -v uv; return 0; fi
  [[ -x "$TOOLS/uv/uv" ]] && { echo "$TOOLS/uv/uv"; return 0; }
  return 1
}

install_uv() {
  local spec name sha url tmp
  spec="$(uv_asset)"
  [[ -n "$spec" ]] || fail "No hay una descarga de uv preparada para este sistema. Instálalo: https://docs.astral.sh/uv/"
  name="${spec%% *}"; sha="${spec##* }"
  url="https://github.com/astral-sh/uv/releases/download/$UV_VERSION/$name"
  info "uv no está instalado. Se descargará uv $UV_VERSION (gestor de Python de Astral, ~17 MB)"
  info "en $TOOLS/uv, verificando su huella SHA-256. No se instala nada en el sistema."
  confirm "¿Descargar uv portátil?" "$@" || fail "uv es necesario para preparar Python."
  tmp="$(mktemp -d)"
  curl -fsSL "$url" -o "$tmp/$name" || fail "No se pudo descargar uv ($url)."
  echo "$sha  $tmp/$name" | shasum -a 256 -c - >/dev/null || { rm -rf "$tmp"; fail "La huella de uv no coincide; descarga descartada."; }
  mkdir -p "$TOOLS/uv"
  tar -xzf "$tmp/$name" -C "$tmp"
  cp "$tmp"/uv-*/uv "$tmp"/uv-*/uvx "$TOOLS/uv/" && chmod +x "$TOOLS/uv/uv" "$TOOLS/uv/uvx"
  rm -rf "$tmp"
  ok "uv $UV_VERSION instalado en $TOOLS/uv"
}

python_env() {
  # Entorno de Python del backend (backend/.venv) con las versiones fijadas en uv.lock.
  local uv
  uv="$(find_uv)" || { install_uv "$@"; uv="$(find_uv)"; }
  export VSA_UV="$uv"
  local extra=()
  # Complemento opcional de NVIDIA (Windows/Linux): se conserva si se instaló antes.
  if has_flag --cuda "$@" || [[ -f "$DATA_HOME/cuda.enabled" ]]; then extra=(--extra cuda); fi
  local dev=(--no-dev)
  [[ "${VSA_DEV_DEPS:-}" == "1" ]] && dev=()
  info "Preparando Python 3.12 y las dependencias del backend (uv sync)…"
  # ${a[@]+"${a[@]}"}: arrays vacíos válidos con «set -u» en el bash 3.2 de macOS.
  (cd "$BACKEND" && "$uv" sync --frozen --quiet ${dev[@]+"${dev[@]}"} ${extra[@]+"${extra[@]}"}) || fail "uv sync falló. Revisa tu conexión y vuelve a ejecutar ./videostudio install."
  ok "Backend listo (backend/.venv)"
}

ensure_installed() {
  if [[ ! -x "$PY" ]] || ! grep -q '"completed_at"' "$DATA_HOME/install-state.json" 2>/dev/null; then
    bold "Video Studio AI aún no está instalado en este equipo: se ejecuta el instalador."
    install_cmd "$@"
    exit $?
  fi
}

install_cmd() {
  bold "Video Studio AI — Community Edition · instalación"
  if [[ "$(uname)" == "Darwin" ]] && ! xcode-select -p >/dev/null 2>&1; then
    info "Aviso: las Command Line Tools de Xcode no están instaladas. No son necesarias."
  fi
  command -v curl >/dev/null || fail "Falta curl."
  python_env "$@"
  cd "$BACKEND" && exec "$PY" -m app.installer "$@"
}

check() {
  # Desarrollo: basta el entorno de Python con las dependencias de desarrollo.
  VSA_DEV_DEPS=1 python_env
  local node_dir
  node_dir="$(cd "$BACKEND" && "$PY" -c 'from app.services.render_engine import find_node; n=find_node(); print(n.parent if n else "")')"
  [[ -n "$node_dir" ]] && export PATH="$node_dir:$PATH"
  bold "Backend"
  local models="${VSA_TEST_MODELS_DIR:-$DATA_HOME/models}"
  (cd "$BACKEND" && .venv/bin/ruff check app tests run.py migrations && .venv/bin/mypy app \
    && VSA_TEST_MODELS_DIR="$models" .venv/bin/pytest -q -o addopts="" -rs)
  bold "Frontend"
  (cd "$FRONTEND" && npm run typecheck && npm run lint && npx vite build --outDir "${VSA_CHECK_DIST:-$(mktemp -d)}" --emptyOutDir --logLevel error)
  bold "Motor de animaciones"
  (cd "$RENDERER" && npx tsc --noEmit)
  ok "Todas las validaciones superadas"
}

dev() {
  [[ -x "$PY" ]] || VSA_DEV_DEPS=1 python_env
  local port="${VSA_PORT:-8775}" token
  token="$(cd "$BACKEND" && "$PY" -c 'from app.config import get_settings; from app.session import ensure_token; print(ensure_token(get_settings().home))')"
  bold "Modo desarrollo — abre http://127.0.0.1:5173/open?t=$token (Ctrl+C para salir)"
  trap 'kill 0' EXIT INT TERM
  (cd "$BACKEND" && VSA_PORT="$port" .venv/bin/uvicorn app.main:create_app --factory \
    --host 127.0.0.1 --port "$port" --reload --reload-dir app) &
  (cd "$FRONTEND" && VSA_BACKEND_URL="http://127.0.0.1:$port" npm run dev) &
  wait
}

launcher() {
  ensure_installed
  cd "$BACKEND" && exec "$PY" -m app.launcher "$@"
}

cmd="${1:-start}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
  install|setup) install_cmd "$@" ;;
  start|stop|restart|status|open|logs|doctor) launcher "$cmd" "$@" ;;
  dev) dev ;;
  check) check ;;
  -h|--help|help) sed -n '2,17p' "$0" ;;
  *) sed -n '2,17p' "$0"; exit 1 ;;
esac
