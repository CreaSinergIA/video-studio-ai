#!/usr/bin/env bash
# Video Studio AI — lanzador local.
#
#   ./videostudio start     Prepara lo necesario, inicia el panel y abre el navegador
#   ./videostudio stop      Detiene el panel
#   ./videostudio restart   Reinicia
#   ./videostudio status    Muestra si está en ejecución
#   ./videostudio logs      Sigue el registro del servidor
#   ./videostudio setup     Instala/actualiza dependencias locales (sin instalaciones globales)
#   ./videostudio dev       Modo desarrollo (Vite con recarga + API con recarga)
#   ./videostudio check     Ejecuta todas las validaciones (tests, typecheck, lint, build)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="$ROOT/backend"
FRONTEND="$ROOT/frontend"
RENDERER="$ROOT/renderer"
PORT="${VSA_PORT:-8775}"  # Community Edition: puerto propio
HOST="127.0.0.1"
URL="http://$HOST:$PORT"

if [[ -n "${VSA_HOME:-}" ]]; then
  DATA_HOME="$VSA_HOME"
elif [[ "$(uname)" == "Darwin" ]]; then
  DATA_HOME="$HOME/Library/Application Support/VideoStudioAI-Community"
else
  DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/videostudioai-community"
fi
RUN_DIR="$DATA_HOME/run"
PID_FILE="$RUN_DIR/server.pid"
LOG_FILE="$DATA_HOME/logs/server.out"

# Homebrew no siempre está en el PATH cuando se lanza desde Finder (.command).
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '  \033[36m›\033[0m %s\n' "$*"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
fail() { printf '  \033[31m✗\033[0m %s\n' "$*" >&2; exit 1; }

require() {
  command -v "$1" >/dev/null 2>&1 || fail "Falta «$1». $2"
}

check_tools() {
  require node "Instala Node.js 20+ (https://nodejs.org o brew install node)."
  require npm "Se instala junto con Node.js."
  require uv "Instala uv (brew install uv)."
  require ffmpeg "Instala FFmpeg (brew install ffmpeg)."
  require ffprobe "Se instala junto con FFmpeg."
}

setup() {
  bold "Preparando dependencias locales"
  check_tools
  info "Backend (Python, entorno en backend/.venv)…"
  (cd "$BACKEND" && uv sync --quiet) && ok "Backend listo"
  info "Frontend (node_modules locales)…"
  if [[ -f "$FRONTEND/package-lock.json" ]]; then
    (cd "$FRONTEND" && npm ci --no-fund --no-audit --loglevel=error) && ok "Frontend listo"
  else
    (cd "$FRONTEND" && npm install --no-fund --no-audit --loglevel=error) && ok "Frontend listo"
  fi
  # Fase 4: motor de animaciones (Remotion, versiones fijadas en package-lock.json). El navegador
  # de render se descarga aparte, solo desde el panel (Ajustes → Motor de animaciones).
  info "Motor de animaciones (renderer/node_modules)…"
  (cd "$RENDERER" && npm ci --no-fund --no-audit --loglevel=error) && ok "Motor de animaciones listo"
}

ensure_deps() {
  [[ -x "$BACKEND/.venv/bin/python" && -d "$FRONTEND/node_modules" && -d "$RENDERER/node_modules" ]] || setup
}

needs_build() {
  local index="$FRONTEND/dist/index.html"
  [[ ! -f "$index" ]] && return 0
  [[ -n "$(find "$FRONTEND/src" "$FRONTEND/index.html" "$FRONTEND/package.json" "$FRONTEND/vite.config.ts" -newer "$index" -print -quit 2>/dev/null)" ]]
}

build_frontend() {
  if needs_build; then
    info "Compilando el panel…"
    (cd "$FRONTEND" && npm run build --silent >/dev/null) && ok "Panel compilado"
  fi
}

server_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE")"
  # Comprobar que el PID sigue siendo nuestro servidor (el sistema reutiliza PIDs).
  if kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o command= 2>/dev/null | grep -q "run.py"; then
    echo "$pid"
    return 0
  fi
  rm -f "$PID_FILE"
  return 1
}

healthy() {
  curl -fsS --max-time 2 "$URL/api/health" >/dev/null 2>&1
}

open_browser() {
  if [[ "${VSA_NO_BROWSER:-}" == "1" ]]; then return; fi
  if command -v open >/dev/null 2>&1; then open "$URL"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL" >/dev/null 2>&1 || true
  fi
}

start() {
  bold "Video Studio AI"
  if pid="$(server_pid)"; then
    ok "Ya está en ejecución (PID $pid) → $URL"
    open_browser
    return
  fi
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    fail "El puerto $PORT está ocupado por otro programa. Usa VSA_PORT=otro_puerto ./videostudio start"
  fi
  check_tools
  ensure_deps
  build_frontend
  mkdir -p "$RUN_DIR" "$(dirname "$LOG_FILE")"
  info "Iniciando servidor en $URL (solo accesible desde este equipo)…"
  (
    cd "$BACKEND"
    VSA_PORT="$PORT" nohup "$BACKEND/.venv/bin/python" run.py >>"$LOG_FILE" 2>&1 &
    echo $! >"$PID_FILE"
  )
  for _ in $(seq 1 60); do
    if healthy; then
      ok "Panel listo → $URL"
      open_browser
      return
    fi
    if ! server_pid >/dev/null; then
      tail -n 20 "$LOG_FILE" >&2 || true
      fail "El servidor no pudo arrancar. Registro: $LOG_FILE"
    fi
    sleep 0.5
  done
  fail "El servidor tarda demasiado en responder. Registro: $LOG_FILE"
}

stop() {
  if pid="$(server_pid)"; then
    info "Deteniendo (PID $pid)…"
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 30); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.5
    done
    if kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o command= | grep -q "run.py"; then
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    ok "Detenido"
  else
    ok "No estaba en ejecución"
  fi
}

status() {
  if pid="$(server_pid)" && healthy; then
    ok "En ejecución (PID $pid) → $URL"
    info "Datos: $DATA_HOME"
  elif pid="$(server_pid)"; then
    info "Proceso $pid activo pero sin responder todavía"
  else
    info "Detenido"
  fi
}

dev() {
  check_tools
  ensure_deps
  bold "Modo desarrollo — panel en http://127.0.0.1:5173 (Ctrl+C para salir)"
  trap 'kill 0' EXIT INT TERM
  (cd "$BACKEND" && VSA_PORT="$PORT" .venv/bin/uvicorn app.main:create_app --factory \
    --host "$HOST" --port "$PORT" --reload --reload-dir app) &
  (cd "$FRONTEND" && VSA_BACKEND_URL="$URL" npm run dev) &
  wait
}

check() {
  check_tools
  ensure_deps
  bold "Backend"
  # Las pruebas de transcripción usan los modelos ya descargados por la app (si existen).
  local models="${VSA_TEST_MODELS_DIR:-$DATA_HOME/models}"
  (cd "$BACKEND" && .venv/bin/ruff check app tests run.py migrations && .venv/bin/mypy app \
    && VSA_TEST_MODELS_DIR="$models" .venv/bin/pytest -q -o addopts="" -rs)
  bold "Frontend"
  (cd "$FRONTEND" && npm run typecheck && npm run lint && npm run build)
  bold "Motor de animaciones"
  (cd "$RENDERER" && npx tsc --noEmit)
  ok "Todas las validaciones superadas"
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  logs) mkdir -p "$(dirname "$LOG_FILE")"; touch "$LOG_FILE"; tail -n 50 -f "$LOG_FILE" ;;
  setup) setup ;;
  dev) dev ;;
  check) check ;;
  *) sed -n '2,12p' "$0"; exit 1 ;;
esac
